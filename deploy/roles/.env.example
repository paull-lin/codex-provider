# Copy to .env (gitignored). Replace every placeholder before starting.
CODEX_ROLES_IMAGE=codex-pool:roles-v2
ANTHROPIC_ADAPTER_IMAGE=anthropic-adapter:mvp
# Defaults preserve the experiment's names, volume and loopback ports.
CODEX_ROLES_PROJECT=codex-roles
CODEX_ROLES_CONTROL_VOLUME=codex-exp-pool-data
# Used for service env_file; use an absolute path with a separate production env.
CODEX_ROLES_ENV_FILE=.env
# With compose.production.yaml: gateway only, 0.0.0.0; no diagnostic host ports.
# CODEX_ROLES_PROJECT=codex-production-roles
# CODEX_ROLES_CONTROL_VOLUME=codex-pool-data
# CODEX_ROLES_PORT=8317
CODEX_POOL_API_KEY=REPLACE_WITH_RANDOM_PUBLIC_API_KEY
CODEX_POOL_INTERNAL_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_INTERNAL_SECRET
# Control's credential broker listens here; do not publish this port.
CODEX_POOL_INTERNAL_ADDR=0.0.0.0:8318
# Generate with the image's hash-password command; quote $ for Compose.
CODEX_POOL_ADMIN_PASSWORD_HASH='REPLACE_WITH_PBKDF2_HASH'
CODEX_POOL_CONTROL_OFFLINE_MAX=30m
